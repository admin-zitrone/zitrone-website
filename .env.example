NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DEBUG=false
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Optional comma-separated origins allowed for browser POST requests.
APP_ALLOWED_ORIGINS=

# Payload CMS
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=
# Postgres connection string (Neon recommended). Get pooled URL from Vercel Marketplace integration.
DATABASE_URL=
# Content source switches (docs/manual-contenido.md). The home, navigation and
# footer render from the code files unless HOME_CONTENT_SOURCE=cms (not used in
# production; docs/cms-home-rollout.md).
# The blog follows the CMS whenever DATABASE_URL is set; set
# BLOG_CONTENT_SOURCE=static only to force the committed articles.
HOME_CONTENT_SOURCE=
BLOG_CONTENT_SOURCE=
# Used by the seed script to bootstrap the first admin user
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# AI embeddings (optional — embeddings are skipped if unset)
OPENAI_API_KEY=

# Resend (transactional email — invites, password reset)
# When unset, Payload disables email features and console-logs would-be sends.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=hola@send.zitrone.mx
RESEND_FROM_NAME=Zitrone

# Production homepage release workflow
# Local env file with production Payload credentials used by `npm run release:home:prod`
HOME_RELEASE_ENV_FILE=.env.production-cms
# Vercel team / scope for production deploys
VERCEL_SCOPE=zitrone
# Live production domain checked after deploy
VERCEL_PRODUCTION_DOMAIN=https://www.zitrone.mx
# Locale used for post-deploy smoke checks
HOME_RELEASE_LOCALE=en
