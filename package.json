{
  "name": "zitrone-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets:sync": "node scripts/assets-sync.mjs",
    "assets:check": "node scripts/assets-sync.mjs --check",
    "images:audit": "node scripts/image-audit.mjs",
    "tokens:data": "node scripts/design-tokens-data.mjs",
    "predev": "node scripts/assets-sync.mjs && node scripts/design-tokens-data.mjs",
    "prebuild": "node scripts/assets-sync.mjs && node scripts/design-tokens-data.mjs",
    "env:check": "tsx scripts/validate-env.ts",
    "email:test": "tsx --env-file=.env.local --env-file-if-exists=.env.development.local scripts/test-contact-delivery.ts",
    "email:retry": "tsx --env-file=.env.local --env-file-if-exists=.env.development.local scripts/retry-contact-emails.ts",
    "leads:sheet": "tsx --env-file=.env.local --env-file-if-exists=.env.development.local scripts/mirror-leads-to-sheet.ts",
    "email:check": "node scripts/email-tokens-check.mjs",
    "email:preview": "tsx scripts/email-preview.ts",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "payload:migrate": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate",
    "payload:migrate:status:prod": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts node --env-file=.env.production-cms node_modules/payload/bin.js migrate:status",
    "payload:migrate:prod": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts node --env-file=.env.production-cms node_modules/payload/bin.js migrate",
    "payload:migrate:create": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate:create",
    "payload:generate-types": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:types",
    "payload:generate-importmap": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:importmap",
    "payload:seed": "tsx --env-file=.env.local scripts/payload/seed.ts",
    "payload:seed:home": "PAYLOAD_DISABLE_REVALIDATE=true PAYLOAD_SEED_SCOPE=home tsx --env-file=.env.local scripts/payload/seed.ts",
    "payload:seed:home:prod": "PAYLOAD_DISABLE_REVALIDATE=true PAYLOAD_SEED_SCOPE=home tsx --env-file=.env.production-cms scripts/payload/seed.ts",
    "payload:sync:blog": "PAYLOAD_DISABLE_REVALIDATE=true tsx --env-file=.env.local scripts/payload/sync-blog-posts.ts",
    "payload:sync:blog:prod": "PAYLOAD_DISABLE_REVALIDATE=true tsx --env-file=.env.production-cms scripts/payload/sync-blog-posts.ts",
    "payload:check:home": "tsx --env-file=.env.local scripts/payload/check-home-parity.ts",
    "payload:check:home:prod": "tsx --env-file=.env.production-cms scripts/payload/check-home-parity.ts",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:scripts": "tsx --test tests/scripts/*.test.ts",
    "test:api": "zsh scripts/test-api-isolated.sh",
    "test:cache": "zsh scripts/test-blog-cache.sh",
    "test:cache:home": "zsh scripts/test-home-cache.sh",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:migration": "playwright test --config playwright.migration.config.ts",
    "test:contact": "playwright test --config playwright.contact.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "design:audit": "zsh scripts/design-system-audit.sh",
    "design:audit:update": "zsh scripts/design-system-audit.sh --update-baseline"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.60",
    "@next/third-parties": "^16.2.10",
    "@number-flow/react": "0.6.2",
    "@payloadcms/db-postgres": "^3.85.2",
    "@payloadcms/email-resend": "^3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "@payloadcms/storage-vercel-blob": "^3.85.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.51.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.175",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.13.2",
    "next": "16.2.10",
    "next-intl": "^4.9.1",
    "payload": "^3.85.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
